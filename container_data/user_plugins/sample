from telethon import events

def register(bot):

    @bot.on(events.NewMessage(pattern=r"^/sample(?:\s+(.*))?$"))
    async def sample(event):

        uid = event.sender_id
        mode = bot.mode.lower()

        if mode == "private":
            if uid != bot.owner_id and uid not in bot.sudo_users:
                return

        query = event.pattern_match.group(1)

        if not query:
            return await event.reply("No input provided.")

        await event.reply(f"Sample plugin received: {query}")
